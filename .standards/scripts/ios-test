#!/usr/bin/env bash
set -euo pipefail

# Run an Xcode test suite on a simulator with a readable log and a trustworthy
# exit status — the body of `just ios-test-unit` / `just ios-test`.
#
#   bin/ios-test [unit|ui|all] [--project P] [--scheme S] [--simulator NAME]
#                              [--destination DEST] [-- extra xcodebuild args]
#
# Every option also reads an environment variable (flag wins):
#
#   IOS_PROJECT       path to the .xcodeproj or .xcworkspace, relative to the
#                     project root (required). A workspace is passed as
#                     -workspace (CocoaPods / Flutter's ios/Runner.xcworkspace).
#   IOS_SCHEME        scheme to test (required)
#   IOS_SIMULATOR     simulator name to prefer          (default "iPhone 16";
#                     falls back to the first available iPhone)
#   IOS_DESTINATION   full -destination string; skips simulator selection
#   IOS_UNIT_TARGET   test target for `unit`             (default "<scheme>Tests")
#   IOS_UI_TARGET     test target for `ui`               (default "<scheme>UITests")
#   IOS_RESULTS_DIR   where .xcresult bundles go         (default test-results/)
#
# A justfile recipe is typically:
#
#   ios-test-unit:
#       IOS_PROJECT=ios/App.xcodeproj IOS_SCHEME=App ./bin/ios-test unit
#
# Why it is shaped like this (best_year run-tests.sh):
#   * pipefail. A bare `xcodebuild | xcpretty` has the FORMATTER's exit status,
#     so a failing suite can green-light `just release`.
#   * The formatter is picked ONCE (xcbeautify -> xcpretty -> `xcodebuild
#     -quiet`). The old `xcodebuild | xcpretty || xcodebuild ...` fallback ran
#     on every machine without xcpretty: the whole suite ran twice and dumped
#     thousands of lines of target-dependency graph into every release log.
#   * -quiet hides which test failed and why, so pass/fail counts and failure
#     messages are read back from the .xcresult bundle and printed.
#   * All progress goes to STDERR: the simulator UDID is returned on stdout via
#     command substitution, and anything else written there ended up inside the
#     -destination string, which xcodebuild then failed to resolve.
#   * The results dir is wiped first: xcodebuild refuses to overwrite an
#     existing -resultBundlePath, and a leftover bundle failed the run.

PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
[ "$(basename "$PROJECT_ROOT")" = ".standards" ] && PROJECT_ROOT="$(dirname "$PROJECT_ROOT")"

if [ -t 2 ]; then
    RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m' NC='\033[0m'
else
    RED='' GREEN='' YELLOW='' NC=''
fi
status() { echo -e "${GREEN}==>${NC} $1" >&2; }
warn()   { echo -e "${YELLOW}Warning:${NC} $1" >&2; }
die()    { echo -e "${RED}Error:${NC} $1" >&2; exit 1; }

usage() {
    sed -n '/^#   bin\/ios-test/,/^#$/p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 1
}

TEST_TYPE="all"
PROJECT="${IOS_PROJECT:-}"
SCHEME="${IOS_SCHEME:-}"
SIMULATOR="${IOS_SIMULATOR:-iPhone 16}"
DESTINATION="${IOS_DESTINATION:-}"
EXTRA=()
while [ $# -gt 0 ]; do
    case "$1" in
        unit|ui|all)   TEST_TYPE="$1" ;;
        --project)     PROJECT="${2:?--project needs a value}"; shift ;;
        --scheme)      SCHEME="${2:?--scheme needs a value}"; shift ;;
        --simulator)   SIMULATOR="${2:?--simulator needs a value}"; shift ;;
        --destination) DESTINATION="${2:?--destination needs a value}"; shift ;;
        --)            shift; EXTRA=("$@"); break ;;
        -h|--help)     usage ;;
        *)             warn "unknown argument: $1"; usage ;;
    esac
    shift
done

[ -n "$PROJECT" ] || die "no Xcode project: set IOS_PROJECT or pass --project"
[ -n "$SCHEME" ]  || die "no scheme: set IOS_SCHEME or pass --scheme"
[[ "$PROJECT" = /* ]] || PROJECT="$PROJECT_ROOT/$PROJECT"
[ -e "$PROJECT" ] || die "not found: $PROJECT"
UNIT_TARGET="${IOS_UNIT_TARGET:-${SCHEME}Tests}"
UI_TARGET="${IOS_UI_TARGET:-${SCHEME}UITests}"
RESULTS_DIR="${IOS_RESULTS_DIR:-$PROJECT_ROOT/test-results}"

case "$PROJECT" in
    *.xcworkspace|*.xcworkspace/) CONTAINER=(-workspace "$PROJECT") ;;
    *)                            CONTAINER=(-project "$PROJECT") ;;
esac

# Prints the UDID on stdout — the ONLY thing this script writes to stdout.
boot_simulator() {
    local udid state
    udid=$(xcrun simctl list devices available | grep -F "$SIMULATOR (" | head -1 | grep -oE '[0-9A-F-]{36}' || true)
    if [ -z "$udid" ]; then
        warn "simulator '$SIMULATOR' not found, using the first available iPhone"
        udid=$(xcrun simctl list devices available | grep "iPhone" | head -1 | grep -oE '[0-9A-F-]{36}' || true)
    fi
    [ -n "$udid" ] || die "no iPhone simulator available (Xcode > Settings > Components)"
    state=$(xcrun simctl list devices | grep "$udid" | grep -oE '\(Booted\)' || true)
    if [ -z "$state" ]; then
        status "Booting simulator $udid..."
        xcrun simctl boot "$udid" >/dev/null 2>&1 || true
        sleep 2
    fi
    echo "$udid"
}

FORMATTER=()
if command -v xcbeautify >/dev/null 2>&1; then
    FORMATTER=(xcbeautify)
elif command -v xcpretty >/dev/null 2>&1; then
    FORMATTER=(xcpretty --color)
fi

SUMMARIZE_PY='
import json, os
data = json.loads(os.environ["RESULT_JSON"])
line = "{} passed, {} failed".format(data.get("passedTests", 0), data.get("failedTests", 0))
if data.get("skippedTests"):
    line += ", {} skipped".format(data["skippedTests"])
print(line)
for f in data.get("testFailures", []):
    print("  FAILED  {}".format(f.get("testIdentifierString", "?")))
    text = (f.get("failureText") or "").strip()
    if text:
        print("          {}".format(text))
'

summarize_results() {
    local bundle="$1" json summary line
    [ -d "$bundle" ] || return 0
    # Xcode 16+ subcommand; on an older toolchain just skip the summary.
    json=$(xcrun xcresulttool get test-results summary --path "$bundle" 2>/dev/null) || return 0
    [ -n "$json" ] || return 0
    summary=$(RESULT_JSON="$json" python3 -c "$SUMMARIZE_PY" 2>/dev/null) || return 0
    while IFS= read -r line; do status "$line"; done <<<"$summary"
}

# run_tests <destination> <label> <bundle-name> [extra xcodebuild args...]
run_tests() {
    local dest="$1" label="$2" bundle="$3" rc=0
    shift 3
    local bundle_path="$RESULTS_DIR/${bundle}.xcresult"
    local args=(test "${CONTAINER[@]}" -scheme "$SCHEME" -destination "$dest"
                -resultBundlePath "$bundle_path" "$@" ${EXTRA[@]+"${EXTRA[@]}"})
    status "Running ${label} ($SCHEME)..."
    if [ ${#FORMATTER[@]} -gt 0 ]; then
        # pipefail so the status is xcodebuild's, not the formatter's.
        ( set -o pipefail; xcodebuild "${args[@]}" | "${FORMATTER[@]}" ) || rc=$?
    else
        xcodebuild -quiet "${args[@]}" || rc=$?
    fi
    summarize_results "$bundle_path"
    return $rc
}

command -v xcodebuild >/dev/null 2>&1 || die "xcodebuild not found (install Xcode)"
[ ${#FORMATTER[@]} -gt 0 ] || status "No xcbeautify/xcpretty — using 'xcodebuild -quiet' (brew install xcbeautify for per-test output)."

rm -rf "$RESULTS_DIR"
mkdir -p "$RESULTS_DIR"

if [ -z "$DESTINATION" ]; then
    UDID=$(boot_simulator)
    status "Using simulator: $UDID"
    DESTINATION="platform=iOS Simulator,id=${UDID}"
fi

rc=0
case "$TEST_TYPE" in
    unit) run_tests "$DESTINATION" "unit tests" unit-tests -only-testing:"$UNIT_TARGET" || rc=$? ;;
    ui)   run_tests "$DESTINATION" "UI tests"   ui-tests   -only-testing:"$UI_TARGET"   || rc=$? ;;
    all)  run_tests "$DESTINATION" "all tests"  all-tests                               || rc=$? ;;
esac

if [ "$rc" -eq 0 ]; then
    status "Tests passed. Results: $RESULTS_DIR"
else
    echo -e "${RED}Tests FAILED${NC} (xcodebuild exit $rc). Results: $RESULTS_DIR" >&2
fi
exit "$rc"
