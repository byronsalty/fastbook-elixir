# Copy to .env and fill in. This file is the committed template; real values
# never go here.
#
#   .env          local dev secrets. Gitignored. Loaded into your shell by
#                 direnv (.envrc runs `dotenv`).
#   .env.prod     local-only copy of the prod secrets. Gitignored and never
#                 sourced into the shell. Push it with
#                 `fly secrets import < .env.prod`; scripts read single vars
#                 with grep. Never cat it.
#   .env.example  this file.
#
# Plain KEY=value lines (dotenv format, no `export`). Optional integrations:
# leave blank and the feature is off.

# --- Required ---
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=
# DATABASE_URL is prod only (set as a Fly secret); dev/test build the
# connection from the ports below.

# --- Local ports ---
# `just up <branch>` writes these per worktree in a managed block at the end
# of .env. Don't edit inside the markers. Set them here only for a checkout
# the devenv engine doesn't manage.
# DEV_DB_PORT=
# TEST_DB_PORT=
# PORT=

# --- TaskRoyale (in-app support tickets; blank = off) ---
ROYALE_URL=https://royale.saltylabs.com
ROYALE_PROJECT_ID=
ROYALE_PASSWORD=

# --- AI (optional; blank = off) ---
OPENAI_API_KEY=

# --- Deploy (optional) ---
# Only needed where `fly auth login` isn't available, e.g. CI or a container.
FLY_API_TOKEN=
